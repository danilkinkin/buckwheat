<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <application
        android:name=".Application"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Buckwheat.Starting"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">
        <receiver
            android:name=".widget.extend.ExtendWidgetReceiver"
            android:label="@string/app_widget_extend_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/extend_app_widget_provider" />
        </receiver>

        <receiver
            android:name=".widget.minimal.MinimalWidgetReceiver"
            android:label="@string/app_widget_minimal_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/minimal_app_widget_provider" />
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
          One alias per theme preset. Only one is enabled at a time; LauncherIcon.kt switches
          them when the palette changes, which is how the launcher icon follows the app theme.
        -->
        <activity-alias
            android:name=".LauncherMac"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mac"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_mac"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherTrippy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_trippy"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_trippy"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherChill"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_chill"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_chill"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherEpic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_epic"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_epic"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherEmotional"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_emotional"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_emotional"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherSunset"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sunset"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_sunset"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>