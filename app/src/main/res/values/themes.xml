<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NoActionBar alone is not enough on every OEM ROM: the platform still inflates the
         decor title bar. Set both attributes explicitly so the app name header never shows. -->
    <style name="Theme.Buckwheat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <!--
      The system draws this before any app code runs, so it cannot read the selected preset.
      A neutral dark background with the receipt mark stays coherent with every palette; the
      launcher icon is the surface that carries the accent.
    -->
    <style name="Theme.Buckwheat.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Buckwheat</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
