<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark counterpart of values-v31/themes.xml. Without this file API 31+ in night mode
         falls back to the *light* v31 theme, because values-night alone does not match. -->
    <style name="Theme.Buckwheat" parent="android:Theme.Material.NoActionBar" />

    <style name="Theme.Buckwheat.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@android:color/system_accent1_500</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Buckwheat</item>
    </style>
</resources>
